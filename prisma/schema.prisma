generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  icon        String      @default("Package")
  equipments  Equipment[]
  createdAt   DateTime    @default(now())
}

model CustomField {
  id          String   @id @default(uuid())
  entity      String   // "equipment", "borrow", "return"
  name        String
  label       String
  type        String   // "text", "number", "date", "dropdown", "checkbox", "boolean"
  required    Boolean  @default(false)
  options     String?  // JSON
  categoryIds String?  // JSON
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Equipment {
  id                String      @id @default(uuid())
  reference         String      @unique
  name              String
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id])
  type              String      // "individual" | "quantity"
  serialNumber      String?
  location          String
  totalQuantity     Int         @default(1)
  availableQuantity Int         @default(1)
  status            String      @default("Disponible")
  customFields      String?     // JSON
  borrowings        Borrowing[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Borrower {
  id         String      @id @default(uuid())
  firstName  String
  lastName   String
  email      String?
  phone      String
  role       String      @default("Étudiant")
  borrowings Borrowing[]
  createdAt  DateTime    @default(now())
}

model Borrowing {
  id                   String    @id @default(uuid())
  reference            String    @unique
  borrowerId           String
  borrower             Borrower  @relation(fields: [borrowerId], references: [id])
  equipmentId          String
  equipment            Equipment @relation(fields: [equipmentId], references: [id])
  quantity             Int       @default(1)
  borrowDate           DateTime  @default(now())
  expectedReturnDate   DateTime
  actualReturnDate     DateTime?
  status               String    @default("En cours")
  snapshotCustomFields String?   // JSON
  returnCondition      String?
  returnNotes          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  details   String
  timestamp DateTime @default(now())
}